<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>so101_bringup</name>
  <version>0.0.1</version>
  <description>
    Top-level launch files, shared params, and actual executable nodes for the
    SO-101 Cartesian servoing stack.
  </description>
  <maintainer email="you@example.com">your_name</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>so101_msgs</depend>
  <depend>so101_kinematics</depend>
  <depend>pinocchio</depend>

  <exec_depend>so101_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
