<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>so101_kinematics</name>
  <version>0.0.1</version>
  <description>
    Shared Pinocchio-based kinematics library for SO-101: forward kinematics,
    reduced translational Jacobian, manipulability, and damped-least-squares
    IK. Linked by both the Cartesian controller and the safety gate so they
    can never disagree about the arm's physical state.
  </description>
  <maintainer email="you@example.com">your_name</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen</depend>

  <!--
    Deliberately NOT declaring a rosdep <depend> on pinocchio: it comes
    from robotpkg (robotpkg-pinocchio 4.1.0), not a ROS/apt rosdep key,
    and is located via CMAKE_PREFIX_PATH / find_package(pinocchio) instead.
    See the top-level README for the environment setup this requires
    (sourcing /opt/openrobots/setup.sh or equivalent) before colcon build.
  -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
